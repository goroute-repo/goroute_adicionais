{
  "alert": "GoRoute API — latência p99 acima de 500ms",
  "alertType": "TRACES_BASED_ALERT",
  "description": "p99 de duração dos spans HTTP do BFF (SLO: < 500ms)",
  "ruleType": "threshold_rule",
  "version": "v5",
  "schemaVersion": "v2alpha1",
  "condition": {
    "compositeQuery": {
      "queryType": "builder",
      "panelType": "graph",
      "unit": "ns",
      "queries": [
        {
          "type": "builder_query",
          "spec": {
            "name": "A",
            "signal": "traces",
            "stepInterval": 60,
            "aggregations": [{ "expression": "p99(duration_nano)" }],
            "filter": { "expression": "service.name = 'goroute-api'" },
            "groupBy": [
              {
                "name": "service.name",
                "fieldContext": "resource",
                "fieldDataType": "string"
              }
            ],
            "legend": "{{service.name}}"
          }
        }
      ]
    },
    "selectedQueryName": "A",
    "thresholds": {
      "kind": "basic",
      "spec": [
        {
          "name": "warning",
          "op": "above",
          "matchType": "at_least_once",
          "target": 0.5,
          "targetUnit": "s",
          "channels": ["__CHANNEL__"]
        }
      ]
    }
  },
  "evaluation": {
    "kind": "rolling",
    "spec": { "evalWindow": "10m0s", "frequency": "1m0s" }
  },
  "notificationSettings": {
    "groupBy": ["service.name"],
    "renotify": { "enabled": false, "interval": "30m", "alertStates": [] }
  },
  "labels": { "severity": "warning", "team": "goroute", "service": "goroute-api" },
  "annotations": {
    "summary": "Latência p99 da API acima de {{$threshold}}s",
    "description": "p99 em {{$service.name}}: {{$value}} (limite {{$threshold}}s)."
  }
}
